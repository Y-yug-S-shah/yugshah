---
import { SITE_URL } from '../config/site';

const nav = [
  { label: 'Home', href: '/' },
  { label: "Milo's mission", href: '/game' },
  { label: 'Resume', href: '/resume' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' }
];
---

<header class="site-header sticky z-50">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex items-center justify-between gap-4 py-1.5">
    <a href="/" class="group flex items-center gap-3 text-xs font-semibold tracking-[0.22em] uppercase transition-all" aria-label="Yug Shah Home">
      <span class="site-brand-avatar">Y</span>
      <span class="site-brand-name">YUG SHAH</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
      {nav.map((item) => (
        <a href={item.href} class={`relative text-xs font-mono tracking-wider transition-colors ${item.href === '/blog' ? 'text-[var(--accent-strong)] font-semibold inline-flex items-center gap-1.5' : 'text-[var(--muted)] hover:text-[var(--accent-strong)]'}`}>
          <span>{item.label}</span>
          {item.href === '/blog' && (
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)]" aria-hidden="true"></span>
          )}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5 sm:gap-3">
      <button id="cli-toggle" type="button" class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--panel)] px-3 py-1.5 text-xs font-mono text-[var(--text)] shadow-sm transition-all hover:border-[var(--accent)] hover:bg-[var(--accent-soft)]" aria-label="Open CLI mode">
        <span aria-hidden="true">⌨️</span>
        <span class="hidden sm:inline">CLI</span>
      </button>
      <button id="sound-toggle" type="button" class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--panel)] px-3 py-1.5 text-xs font-mono text-[var(--text)] shadow-sm transition-all hover:border-[var(--accent)] hover:bg-[var(--accent-soft)]" aria-label="Turn ambient and click sounds on" aria-pressed="false">
        <span aria-hidden="true">🔇</span>
        <span class="hidden sm:inline">Sound off</span>
      </button>
      <button id="theme-toggle" type="button" class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--panel)] px-3 py-1.5 text-xs font-mono text-[var(--text)] shadow-sm transition-all hover:border-[var(--accent)] hover:bg-[var(--accent-soft)]" aria-label="Toggle color theme">
        <span aria-hidden="true">☀️</span>
        <span class="hidden sm:inline">Theme</span>
      </button>
      <a href="/contact" aria-label="Contact Yug Shah" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-sky-400 via-cyan-300 to-sky-400 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-slate-950 shadow-lg shadow-sky-500/25 transition-all hover:scale-105 hover:shadow-sky-500/40 hover:brightness-110 active:scale-95">
        <span class="sm:hidden" aria-hidden="true">✉</span>
        <span class="hidden sm:inline">Hire me</span>
      </a>
    </div>
    </div>
    <nav aria-label="Mobile primary" class="mx-auto flex max-w-6xl items-center gap-5 overflow-x-auto pb-2 text-xs lg:hidden">
      {nav.map((item) => (
        <a href={item.href} class={`shrink-0 transition-colors inline-flex items-center gap-1.5 ${item.href === '/blog' ? 'text-[var(--accent-strong)] font-semibold' : 'text-[var(--muted)] hover:text-[var(--text)]'}`}>
          <span>{item.label}</span>
          {item.href === '/blog' && (
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)]" aria-hidden="true"></span>
          )}
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline define:vars={{ SITE_URL }}>
  const root = document.documentElement;
  const saved = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const initial = saved || (prefersDark ? 'dark' : 'light');
  root.setAttribute('data-theme', initial);

  const button = document.getElementById('theme-toggle');
  if (button) {
    const syncLabel = () => {
      const theme = root.getAttribute('data-theme');
      button.innerHTML = theme === 'dark' ? '<span aria-hidden="true">🌙</span><span class="hidden sm:inline">Dark</span>' : '<span aria-hidden="true">☀️</span><span class="hidden sm:inline">Light</span>';
    };
    syncLabel();
    button.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      syncLabel();
    });
  }

  const cliButton = document.getElementById('cli-toggle');
  const setCliMode = (open, replace = false) => {
    const url = new URL(window.location.href);
    if (open) {
      url.searchParams.set('mode', 'cli');
    } else {
      url.searchParams.delete('mode');
    }
    window.history[replace ? 'replaceState' : 'pushState']({}, '', url.toString());
    window.dispatchEvent(new CustomEvent(open ? 'portfolio:open-cli' : 'portfolio:close-cli'));
  };
  cliButton?.addEventListener('click', () => setCliMode(true));
  window.addEventListener('portfolio:request-close-cli', () => setCliMode(false, true));
  window.addEventListener('keydown', (event) => {
    const target = event.target;
    const isTyping = target instanceof HTMLElement &&
      (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));
    if (event.key === '`' && !event.repeat && !isTyping) {
      event.preventDefault();
      setCliMode(new URLSearchParams(window.location.search).get('mode') !== 'cli');
    } else if (event.key === 'Escape' && new URLSearchParams(window.location.search).get('mode') === 'cli') {
      setCliMode(false, true);
    }
  });
  window.addEventListener('popstate', () => {
    window.dispatchEvent(new CustomEvent(
      new URLSearchParams(window.location.search).get('mode') === 'cli'
        ? 'portfolio:open-cli'
        : 'portfolio:close-cli'
    ));
  });

  const soundButton = document.getElementById('sound-toggle');
  const soundStorageKey = 'portfolio-ui-sound';
  let soundEnabled = localStorage.getItem(soundStorageKey) === 'on';
  let audioContext;
  let ambienceGain;
  let ambienceTimer;
  let clickBuffer;
  let chordStep = 0;
  const pianoChords = [
    [261.63, 329.63, 392],
    [220, 261.63, 329.63],
    [174.61, 220, 261.63],
    [196, 246.94, 293.66]
  ];
  const stopAmbience = () => {
    if (ambienceTimer) window.clearInterval(ambienceTimer);
    ambienceTimer = undefined;
    if (!ambienceGain || !audioContext) return;
    const gain = ambienceGain;
    ambienceGain = undefined;
    gain.gain.cancelScheduledValues(audioContext.currentTime);
    gain.gain.setTargetAtTime(0, audioContext.currentTime, 0.12);
    window.setTimeout(() => gain.disconnect(), 800);
  };
  const playPianoChord = () => {
    if (!audioContext || !ambienceGain || audioContext.state !== 'running') return;
    const chord = pianoChords[chordStep % pianoChords.length];
    chordStep += 1;
    chord.forEach((frequency, index) => {
      const startAt = audioContext.currentTime + index * 0.089;
      const noteGain = audioContext.createGain();
      noteGain.gain.setValueAtTime(0.0001, startAt);
      noteGain.gain.exponentialRampToValueAtTime(0.0495 / (index + 1), startAt + 0.015);
      noteGain.gain.exponentialRampToValueAtTime(0.0001, startAt + 1.808);
      noteGain.connect(ambienceGain);
      [1, 2, 3].forEach((harmonic, partial) => {
        const oscillator = audioContext.createOscillator();
        const partialGain = audioContext.createGain();
        oscillator.type = 'sine';
        oscillator.frequency.value = frequency * harmonic;
        partialGain.gain.value = [1, 0.11, 0.025][partial];
        oscillator.connect(partialGain);
        partialGain.connect(noteGain);
        oscillator.start(startAt);
        oscillator.stop(startAt + 1.842);
        oscillator.addEventListener('ended', () => {
          oscillator.disconnect();
          partialGain.disconnect();
        }, { once: true });
      });
      window.setTimeout(() => noteGain.disconnect(), 1942);
    });
  };
  const startAmbience = async () => {
    if (!soundEnabled) return;
    const AudioContextConstructor = window.AudioContext;
    if (!AudioContextConstructor) return;
    audioContext ??= new AudioContextConstructor();
    if (audioContext.state === 'suspended') await audioContext.resume();
    if (!soundEnabled || ambienceGain) return;

    ambienceGain = audioContext.createGain();
    ambienceGain.gain.setValueAtTime(0.99, audioContext.currentTime);
    ambienceGain.connect(audioContext.destination);
    playPianoChord();
    ambienceTimer = window.setInterval(playPianoChord, 3111);
  };
  const playClick = () => {
    if (!soundEnabled || !audioContext || audioContext.state !== 'running') return;
    if (!clickBuffer) {
      clickBuffer = audioContext.createBuffer(1, Math.ceil(audioContext.sampleRate * 0.02), audioContext.sampleRate);
      const samples = clickBuffer.getChannelData(0);
      for (let index = 0; index < samples.length; index += 1) {
        samples[index] = (Math.random() * 2 - 1) * (1 - index / samples.length);
      }
    }
    const now = audioContext.currentTime;
    const noise = audioContext.createBufferSource();
    const filter = audioContext.createBiquadFilter();
    const noiseGain = audioContext.createGain();
    noise.buffer = clickBuffer;
    filter.type = 'bandpass';
    filter.frequency.value = 1900;
    filter.Q.value = 0.8;
    noiseGain.gain.setValueAtTime(0.0001, now);
    noiseGain.gain.exponentialRampToValueAtTime(0.018, now + 0.002);
    noiseGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.025);
    noise.connect(filter);
    filter.connect(noiseGain);
    noiseGain.connect(audioContext.destination);
    noise.start(now);
    noise.stop(now + 0.026);

    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();
    oscillator.type = 'triangle';
    oscillator.frequency.setValueAtTime(920, now);
    oscillator.frequency.exponentialRampToValueAtTime(390, now + 0.035);
    gain.gain.setValueAtTime(0.0001, now);
    gain.gain.exponentialRampToValueAtTime(0.0064, now + 0.002);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.045);
    oscillator.connect(gain);
    gain.connect(audioContext.destination);
    oscillator.start(now);
    oscillator.stop(now + 0.05);
    oscillator.addEventListener('ended', () => {
      oscillator.disconnect();
      gain.disconnect();
    }, { once: true });
    noise.addEventListener('ended', () => {
      noise.disconnect();
      filter.disconnect();
      noiseGain.disconnect();
    }, { once: true });
  };
  const syncSoundButton = () => {
    soundButton?.setAttribute('aria-pressed', String(soundEnabled));
    soundButton?.setAttribute('aria-label', soundEnabled ? 'Turn ambient and click sounds off' : 'Turn ambient and click sounds on');
    if (soundButton) {
      soundButton.innerHTML = soundEnabled
        ? '<span aria-hidden="true">♫</span><span class="hidden sm:inline">Sound on</span>'
        : '<span aria-hidden="true">♩</span><span class="hidden sm:inline">Sound off</span>';
    }
  };
  syncSoundButton();
  soundButton?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    localStorage.setItem(soundStorageKey, soundEnabled ? 'on' : 'off');
    syncSoundButton();
    if (soundEnabled) {
      void startAmbience().then(playClick);
    } else {
      stopAmbience();
    }
  });
  document.addEventListener('pointerdown', () => {
    if (soundEnabled && !audioContext) {
      void startAmbience().then(playClick);
      return;
    }
    playClick();
  }, { capture: true });
  window.addEventListener('pagehide', stopAmbience);
</script>
