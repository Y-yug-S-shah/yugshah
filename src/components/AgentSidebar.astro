<aside class="agent-sidebar" aria-label="AI companion">
  <p class="agent-sidebar-label">YOUR AGENT</p>
  <div class="agent-sidebar-track">
    <span class="agent-track-node agent-track-node-top" aria-hidden="true"></span>
    <span class="agent-track-node agent-track-node-bottom" aria-hidden="true"></span>
    <div class="agent-runner" aria-label="Milo, your AI companion">
      <svg class="agent-avatar" viewBox="0 0 80 80" role="img" aria-labelledby="agent-title">
        <title id="agent-title">Milo the AI companion</title>
        <defs>
          <linearGradient id="agent-glass" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff9ed" stop-opacity=".96" />
            <stop offset="1" stop-color="#b6c0c5" stop-opacity=".82" />
          </linearGradient>
          <linearGradient id="agent-ear" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#e3c9a8" />
            <stop offset="1" stop-color="#a68a70" />
          </linearGradient>
        </defs>
        <ellipse cx="40" cy="70" rx="21" ry="4" fill="#0b0c0f" opacity=".14" />
        <g class="agent-bob">
          <path d="M19 30 12 16q-2-5 3-5l14 11m22 8 5-15q2-5 6-2l7 11" fill="url(#agent-ear)" stroke="#86755f" stroke-width="2" stroke-linejoin="round" />
          <rect x="16" y="20" width="48" height="38" rx="17" fill="url(#agent-glass)" stroke="#8e9592" stroke-width="1.5" />
          <path d="M21 30q3-8 12-8h15" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="2" opacity=".9" />
          <circle class="agent-eye" cx="30" cy="39" r="3.2" fill="#454b4b" />
          <circle class="agent-eye" cx="50" cy="39" r="3.2" fill="#454b4b" />
          <path d="M35 48q5 4 10 0" fill="none" stroke="#8b725e" stroke-linecap="round" stroke-width="1.8" />
          <circle cx="23" cy="45" r="3" fill="#c9a994" opacity=".48" />
          <circle cx="57" cy="45" r="3" fill="#c9a994" opacity=".48" />
          <path d="M31 59v7m18-7v7" stroke="#787f7c" stroke-linecap="round" stroke-width="5" />
          <path class="agent-leg agent-leg-left" d="m31 66-3 5m21-5 3 5" fill="none" stroke="#727876" stroke-linecap="round" stroke-width="4" />
        </g>
      </svg>
      <span class="agent-shadow" aria-hidden="true"></span>
    </div>
  </div>
  <div class="agent-sidebar-caption">
    <span class="agent-online-dot" aria-hidden="true"></span>
    <span>MILO</span>
  </div>
  <p class="agent-sidebar-note">learning<br />with care</p>
</aside>

<script is:inline>
  (() => {
    const sidebar = document.querySelector('.agent-sidebar');
    if (!sidebar) return;

    let frame = 0;
    const updatePosition = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        const maximumScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const progress = Math.min(0.84, Math.max(0, window.scrollY / maximumScroll) * 0.84);
        sidebar.style.setProperty('--agent-progress', `${(progress * 100).toFixed(1)}%`);
      });
    };

    updatePosition();
    window.addEventListener('scroll', updatePosition, { passive: true });
    window.addEventListener('resize', updatePosition);
  })();
</script>
