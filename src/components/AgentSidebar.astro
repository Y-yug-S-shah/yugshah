<aside class="agent-sidebar" aria-label="AI companion">
  <p class="agent-sidebar-label">YOUR AGENT</p>
  <div
    class="agent-sidebar-track"
    role="scrollbar"
    aria-label="Scroll the page with Milo"
    aria-controls="main-content"
    aria-orientation="vertical"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    tabindex="0"
  >
    <span class="agent-track-node agent-track-node-top" aria-hidden="true"></span>
    <span class="agent-track-node agent-track-node-bottom" aria-hidden="true"></span>
    <div class="agent-runner" aria-label="Milo, your AI companion">
      <svg class="agent-avatar" viewBox="0 0 80 80" role="img" aria-labelledby="agent-title">
        <title id="agent-title">Milo the AI companion</title>
        <defs>
          <linearGradient id="agent-glass" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff9ed" stop-opacity=".96" />
            <stop offset="1" stop-color="#b6c0c5" stop-opacity=".82" />
          </linearGradient>
          <linearGradient id="agent-ear" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#e3c9a8" />
            <stop offset="1" stop-color="#a68a70" />
          </linearGradient>
        </defs>
        <ellipse cx="40" cy="70" rx="21" ry="4" fill="#0b0c0f" opacity=".14" />
        <g class="agent-bob">
          <path d="M19 30 12 16q-2-5 3-5l14 11m22 8 5-15q2-5 6-2l7 11" fill="url(#agent-ear)" stroke="#86755f" stroke-width="2" stroke-linejoin="round" />
          <rect x="16" y="20" width="48" height="38" rx="17" fill="url(#agent-glass)" stroke="#8e9592" stroke-width="1.5" />
          <path d="M21 30q3-8 12-8h15" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="2" opacity=".9" />
          <circle class="agent-eye" cx="30" cy="39" r="3.2" fill="#454b4b" />
          <circle class="agent-eye" cx="50" cy="39" r="3.2" fill="#454b4b" />
          <path d="M35 48q5 4 10 0" fill="none" stroke="#8b725e" stroke-linecap="round" stroke-width="1.8" />
          <circle cx="23" cy="45" r="3" fill="#c9a994" opacity=".48" />
          <circle cx="57" cy="45" r="3" fill="#c9a994" opacity=".48" />
          <path d="M31 59v7m18-7v7" stroke="#787f7c" stroke-linecap="round" stroke-width="5" />
          <path class="agent-leg agent-leg-left" d="m31 66-3 5m21-5 3 5" fill="none" stroke="#727876" stroke-linecap="round" stroke-width="4" />
        </g>
      </svg>
      <span class="agent-shadow" aria-hidden="true"></span>
    </div>
  </div>
  <div class="agent-sidebar-caption">
    <span>MILO</span>
  </div>
  <p class="agent-sidebar-note">AI agent<br />in training</p>
</aside>

<script is:inline>
  (() => {
    let currentCleanup = null;

    function initAgentScrollbar() {
      if (typeof currentCleanup === 'function') {
        currentCleanup();
        currentCleanup = null;
      }

      const sidebar = document.querySelector('.agent-sidebar');
      const track = sidebar?.querySelector('.agent-sidebar-track');
      if (!sidebar || !(track instanceof HTMLElement)) return;

      let isDragging = false;
      let activePointerId = null;
      let rafId = 0;

      const getMaxScroll = () => {
        return Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      };

      const updatePosition = () => {
        if (rafId) return;
        rafId = window.requestAnimationFrame(() => {
          rafId = 0;
          const maxScroll = getMaxScroll();
          const ratio = Math.min(1, Math.max(0, window.scrollY / maxScroll));
          const progress = ratio * 0.84;
          sidebar.style.setProperty('--agent-progress', `${(progress * 100).toFixed(1)}%`);
          track.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
        });
      };

      const scrollToPointer = (clientY) => {
        const bounds = track.getBoundingClientRect();
        if (bounds.height <= 0) return;
        const ratio = Math.min(1, Math.max(0, (clientY - bounds.top) / bounds.height));
        const maxScroll = getMaxScroll();
        const targetTop = ratio * maxScroll;
        window.scrollTo(0, targetTop);
        const progress = ratio * 0.84;
        sidebar.style.setProperty('--agent-progress', `${(progress * 100).toFixed(1)}%`);
        track.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
      };

      const onPointerDown = (event) => {
        if (event.button !== 0) return;
        isDragging = true;
        activePointerId = event.pointerId;
        sidebar.classList.add('is-dragging');
        try {
          track.setPointerCapture(event.pointerId);
        } catch {}
        scrollToPointer(event.clientY);
      };

      const onPointerMove = (event) => {
        if (!isDragging) return;
        if (activePointerId !== null && event.pointerId !== activePointerId) return;
        scrollToPointer(event.clientY);
      };

      const stopDragging = (event) => {
        if (!isDragging) return;
        if (activePointerId !== null && event.pointerId !== undefined && event.pointerId !== activePointerId) return;
        isDragging = false;
        sidebar.classList.remove('is-dragging');
        if (activePointerId !== null) {
          try {
            if (track.hasPointerCapture(activePointerId)) {
              track.releasePointerCapture(activePointerId);
            }
          } catch {}
          activePointerId = null;
        }
      };

      const onKeyDown = (event) => {
        const step = Math.max(120, window.innerHeight * 0.12);
        if (event.key === 'ArrowDown' || event.key === 'PageDown') {
          event.preventDefault();
          window.scrollBy(0, step);
        } else if (event.key === 'ArrowUp' || event.key === 'PageUp') {
          event.preventDefault();
          window.scrollBy(0, -step);
        } else if (event.key === 'Home') {
          event.preventDefault();
          window.scrollTo(0, 0);
        } else if (event.key === 'End') {
          event.preventDefault();
          window.scrollTo(0, document.documentElement.scrollHeight);
        }
      };

      track.addEventListener('pointerdown', onPointerDown);
      track.addEventListener('pointermove', onPointerMove);
      track.addEventListener('pointerup', stopDragging);
      track.addEventListener('pointercancel', stopDragging);
      track.addEventListener('lostpointercapture', stopDragging);
      track.addEventListener('keydown', onKeyDown);

      window.addEventListener('scroll', updatePosition, { passive: true });
      window.addEventListener('resize', updatePosition, { passive: true });

      updatePosition();

      currentCleanup = () => {
        if (rafId) window.cancelAnimationFrame(rafId);
        track.removeEventListener('pointerdown', onPointerDown);
        track.removeEventListener('pointermove', onPointerMove);
        track.removeEventListener('pointerup', stopDragging);
        track.removeEventListener('pointercancel', stopDragging);
        track.removeEventListener('lostpointercapture', stopDragging);
        track.removeEventListener('keydown', onKeyDown);
        window.removeEventListener('scroll', updatePosition);
        window.removeEventListener('resize', updatePosition);
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAgentScrollbar);
    } else {
      initAgentScrollbar();
    }

    document.addEventListener('astro:page-load', initAgentScrollbar);
  })();
</script>
