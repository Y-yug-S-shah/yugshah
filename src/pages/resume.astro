---
import BaseLayout from '../layouts/BaseLayout.astro';
import resumeData from '../data/resume.json';

const { basics, work, education, projects, skills, certifications, awards } = resumeData;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: basics.name,
  email: basics.email,
  url: basics.url,
  jobTitle: basics.label,
  description: basics.summary,
  sameAs: [
    'https://www.linkedin.com/in/yugshah369/',
    'https://github.com/Y-yug-S-shah',
    'https://www.youtube.com/@DefenderDiarybyYug'
  ],
  knowsAbout: ['Cybersecurity', 'Networking', 'Security operations', 'Technical validation']
};
---

<BaseLayout title="Resume | Yug Shah" description="Professional resume for Yug Shah, covering security roles, research, education, and certifications." image="/og/resume.svg" jsonLd={jsonLd} canonicalPath="/resume">
  <article class="resume-document">
    <header class="resume-masthead">
      <div class="resume-masthead-top">
        <p class="resume-kicker"><span></span> PROFESSIONAL PROFILE <span>2026</span></p>
        <div class="resume-actions">
          <a href="/resume.pdf" download class="resume-download">Download PDF <span aria-hidden="true">↓</span></a>
          <a href={`mailto:${basics.email}`} class="resume-contact-button">Contact</a>
        </div>
      </div>
      <div class="resume-identity">
        <div>
          <h1>{basics.name}</h1>
          <p class="resume-role">{basics.label}</p>
        </div>
        <p class="resume-intro">{basics.summary}</p>
      </div>
      <div class="resume-contact-row">
        <a href={`mailto:${basics.email}`}>{basics.email}</a>
        <a href={basics.url} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/Y-yug-S-shah" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="resume-section resume-work-section">
      <div class="resume-section-heading"><span>01</span><h2>Experience</h2><i></i></div>
      {work.map((job) => (
        <article class={`resume-role-card${job.company === 'Palo Alto Networks' ? ' is-palo-alto' : ''}`}>
          <div class="resume-role-marker" aria-hidden="true">{job.company === 'Palo Alto Networks' ? 'PAN' : job.company.slice(0, 3).toUpperCase()}</div>
          <div class="resume-role-content">
            <div class="resume-role-title-row">
              <div>
                <h3>{job.position}</h3>
                <p class="resume-company">{job.company}</p>
              </div>
              <span class="resume-date">{job.startDate} — {job.endDate}</span>
            </div>
            <p class="resume-role-summary">{job.summary}</p>
            {job.company === 'Palo Alto Networks' && <span class="resume-emphasis">TECHNICAL SOLUTIONS · CUSTOMER-FACING</span>}
          </div>
        </article>
      ))}
    </section>

    <section class="resume-section">
      <div class="resume-section-heading"><span>02</span><h2>Selected projects</h2><i></i></div>
      <div class="resume-project-grid">
        {projects.map((project) => (
          <article class="resume-project-card">
            <div class="resume-project-top"><span>SECURITY PROJECT</span><span aria-hidden="true">↗</span></div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <div class="resume-tag-list">
              {project.keywords.map((keyword) => <span>{keyword}</span>)}
            </div>
            <a href={project.url} target="_blank" rel="noreferrer">View repository <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-section">
      <div class="resume-section-heading"><span>03</span><h2>Capabilities</h2><i></i></div>
      <div class="resume-skills-grid">
        {skills.map((skillGroup) => (
          <article class="resume-skill-card">
            <h3>{skillGroup.name}</h3>
            <ul>{skillGroup.keywords.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <div class="resume-bottom-grid">
      <section class="resume-section">
        <div class="resume-section-heading"><span>04</span><h2>Education</h2><i></i></div>
        {education.map((item) => (
          <article class="resume-education-card">
            <h3>{item.studyType} in {item.area}</h3>
            <p>{item.institution}</p>
            <span>{item.endDate}</span>
          </article>
        ))}
      </section>

      <section class="resume-section">
        <div class="resume-section-heading"><span>05</span><h2>Certifications</h2><i></i></div>
        <ul class="resume-cert-list">
          {certifications.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>

    <section class="resume-section resume-achievement">
      <div class="resume-section-heading"><span>06</span><h2>Recognition</h2><i></i></div>
      {awards.map((award) => (
        <article>
          <h3>{award.title}</h3>
          <p>{award.summary}</p>
          <span>{award.awarder} · {award.date}</span>
        </article>
      ))}
    </section>
  </article>
</BaseLayout>
