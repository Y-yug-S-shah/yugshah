---
import BaseLayout from '../layouts/BaseLayout.astro';
import resumeData from '../data/resume.json';

const { basics, work, education, skills, certifications, awards } = resumeData;
---

<BaseLayout title="Resume | Yug Shah" description="Professional resume for Yug Shah, covering security roles, research, education, and certifications.">
  <article class="prose prose-invert max-w-none rounded-[32px] border border-[var(--border)] bg-[var(--panel)] p-6 sm:p-8 lg:p-10">
    <header class="mb-10 border-b border-[var(--border)] pb-6">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.32em] text-[var(--muted)]">Resume</p>
      <h1 class="text-4xl font-black tracking-tight text-[var(--text)]">{basics.name}</h1>
      <p class="mt-2 text-lg text-[var(--muted)]">{basics.label}</p>
      <div class="mt-5 flex flex-wrap gap-4 text-sm text-[var(--muted)]">
        <a href={`mailto:${basics.email}`} class="hover:text-[var(--text)]">{basics.email}</a>
        <a href={basics.url} class="hover:text-[var(--text)]">LinkedIn</a>
      </div>
    </header>

    <section class="mb-10">
      <h2 class="mb-3 text-2xl font-bold text-[var(--text)]">Professional Summary</h2>
      <p class="text-base leading-8 text-[var(--muted)]">{basics.summary}</p>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text)]">Education</h2>
      {education.map((item) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-soft)] p-4">
          <h3 class="text-lg font-semibold text-[var(--text)]">{item.institution}</h3>
          <p class="mt-1 text-[var(--muted)]">{item.studyType} in {item.area} · {item.endDate}</p>
        </div>
      ))}
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text)]">Work History</h2>
      {work.map((job) => (
        <article class="mb-4 rounded-2xl border border-[var(--border)] bg-[var(--bg-soft)] p-4">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-lg font-semibold text-[var(--text)]">{job.position}</h3>
            <span class="text-sm text-[var(--muted)]">{job.startDate} — {job.endDate}</span>
          </div>
          <p class="mt-2 text-base font-medium text-[var(--accent-strong)]">{job.company}</p>
          <p class="mt-3 text-base leading-8 text-[var(--muted)]">{job.summary}</p>
        </article>
      ))}
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text)]">Skills</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {skills.map((skillGroup) => (
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-soft)] p-4">
            <h3 class="mb-3 text-lg font-semibold text-[var(--text)]">{skillGroup.name}</h3>
            <ul class="space-y-2 text-sm text-[var(--muted)]">
              {skillGroup.keywords.map((item) => <li>• {item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text)]">Certifications</h2>
      <ul class="space-y-2 text-base text-[var(--muted)]">
        {certifications.map((item) => <li>• {item}</li>)}
      </ul>
    </section>

    <section>
      <h2 class="mb-4 text-2xl font-bold text-[var(--text)]">Achievements</h2>
      {awards.map((award) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-soft)] p-4">
          <p class="text-lg font-semibold text-[var(--text)]">{award.title}</p>
          <p class="mt-1 text-sm text-[var(--muted)]">{award.awarder} · {award.date}</p>
          <p class="mt-2 text-base leading-8 text-[var(--muted)]">{award.summary}</p>
        </div>
      ))}
    </section>
  </article>
</BaseLayout>
