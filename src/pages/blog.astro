---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog | Yug Shah" description="Blog landing page for Yug Shah. Content and reading features are being prepared in Phase 3.">
  <section class="space-y-8 py-6">
    <div class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[var(--muted)]">Blog</p>
      <h1 class="text-4xl font-black tracking-tight text-[var(--text)]">Notes from the field</h1>
      <p class="max-w-2xl text-base leading-8 text-[var(--muted)]">This is the blog landing page placeholder. In Phase 3, it will include the MDX content collection, search, tags, and reading experience.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <article class="rounded-[28px] border border-[var(--border)] bg-[var(--panel)] p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--muted)]">Draft post</p>
        <h2 class="mt-4 text-2xl font-bold text-[var(--text)]">Sample article placeholder</h2>
        <p class="mt-3 text-base leading-8 text-[var(--muted)]">Future posts will cover security investigations, architecture notes, and practical product thinking.</p>
        <a href="/blog/sample-post" class="mt-5 inline-flex text-sm font-semibold text-[var(--accent-strong)]">Open article →</a>
      </article>
      <article class="rounded-[28px] border border-[var(--border)] bg-[var(--panel)] p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--muted)]">Draft post</p>
        <h2 class="mt-4 text-2xl font-bold text-[var(--text)]">Another placeholder entry</h2>
        <p class="mt-3 text-base leading-8 text-[var(--muted)]">This will later become a real article with tags, reading time, and related content.</p>
        <a href="/blog/another-placeholder" class="mt-5 inline-flex text-sm font-semibold text-[var(--accent-strong)]">Open article →</a>
      </article>
    </div>
  </section>
</BaseLayout>
