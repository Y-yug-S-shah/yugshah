---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import { SITE_URL } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Yug Shah',
  description: 'Contact Yug Shah about projects, opportunities, or technical discussions.',
  url: `${SITE_URL}/contact`,
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    email: profile.email,
    sameAs: [
      profile.socialLinks.linkedin,
      profile.socialLinks.github,
      profile.socialLinks.youtube
    ]
  }
};
---

<BaseLayout title="Contact | Yug Shah" description="Contact Yug Shah about projects, opportunities, or technical discussions." image="/og/home.svg" jsonLd={jsonLd} canonicalPath="/contact">
  <section class="grid gap-10 py-8 lg:grid-cols-[0.9fr_1.1fr] items-start">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border-accent)] bg-[var(--accent-soft)] px-3.5 py-1.5 text-xs font-mono font-medium text-[var(--accent-strong)] backdrop-blur-md">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="tracking-wider">DIRECT COMMUNICATION CHANNEL</span>
      </div>

      <div class="space-y-4">
        <h1 class="hero-main-title text-4xl font-black tracking-tight sm:text-5xl">Let’s build something useful.</h1>
        <p class="text-base text-[var(--text-secondary)] leading-relaxed">
          I work across AI security, technical validation, and customer-facing problem solving. If you want to talk through a security initiative, architecture question, or collaboration, get in touch below.
        </p>
      </div>

      <div class="rounded-[28px] border border-[var(--border-thick)] border-[var(--border)] bg-[var(--panel)] p-6 backdrop-blur-md space-y-4 shadow-xl">
        <h2 class="text-xs font-mono uppercase tracking-widest text-[var(--accent-strong)]">// VERIFIED CHANNELS</h2>
        <div class="space-y-3 text-sm font-mono">
          <a href={`mailto:${profile.email}`} class="flex items-center justify-between p-3 rounded-xl border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent-strong)]">
            <span class="text-[var(--text-secondary)]">Email</span>
            <span class="text-[var(--accent-strong)]">{profile.email} ↗</span>
          </a>
          <a href={profile.socialLinks.linkedin} target="_blank" rel="noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent-strong)]">
            <span class="text-[var(--text-secondary)]">LinkedIn</span>
            <span class="text-[var(--text)]">yugshah369 ↗</span>
          </a>
          <a href={profile.socialLinks.github} target="_blank" rel="noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent-strong)]">
            <span class="text-[var(--text-secondary)]">GitHub</span>
            <span class="text-[var(--text)]">Y-yug-S-shah ↗</span>
          </a>
          <a href={profile.socialLinks.youtube} target="_blank" rel="noreferrer" class="flex items-center justify-between p-3 rounded-xl border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent-strong)]">
            <span class="text-[var(--text-secondary)]">YouTube</span>
            <span class="text-[var(--text)]">@DefenderDiarybyYug ↗</span>
          </a>
        </div>
      </div>
    </div>

    <form id="contact-form" class="rounded-[32px] border border-[var(--border-thick)] border-[var(--border)] bg-[var(--panel)] p-6 sm:p-8 backdrop-blur-md shadow-2xl space-y-5">
      <!-- OWASP A04: Anti-bot honeypot field -->
      <input name="company_website" type="text" tabindex="-1" autocomplete="off" class="sr-only opacity-0 pointer-events-none absolute -left-[9999px]" aria-hidden="true" />
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-xs font-mono uppercase tracking-wider text-[var(--muted)] sm:col-span-1">
          Your Name
          <input name="name" type="text" required placeholder="Jane Doe" class="mt-2 w-full rounded-xl border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] px-4 py-3 text-sm text-[var(--text)] outline-none transition-colors focus:border-[var(--accent)] focus:bg-[var(--panel-solid)]" />
        </label>
        <label class="block text-xs font-mono uppercase tracking-wider text-[var(--muted)] sm:col-span-1">
          Email Address
          <input name="email" type="email" required placeholder="you@domain.com" class="mt-2 w-full rounded-xl border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] px-4 py-3 text-sm text-[var(--text)] outline-none transition-colors focus:border-[var(--accent)] focus:bg-[var(--panel-solid)]" />
        </label>
        <label class="block text-xs font-mono uppercase tracking-wider text-[var(--muted)] sm:col-span-2">
          Subject / Area of Interest
          <input name="subject" type="text" required placeholder="AI Security / PoC Architecture / Role Opportunity" class="mt-2 w-full rounded-xl border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] px-4 py-3 text-sm text-[var(--text)] outline-none transition-colors focus:border-[var(--accent)] focus:bg-[var(--panel-solid)]" />
        </label>
        <label class="block text-xs font-mono uppercase tracking-wider text-[var(--muted)] sm:col-span-2">
          Message
          <textarea name="message" rows="5" required placeholder="Tell me about your initiative, problem statement, or goal..." class="mt-2 w-full rounded-xl border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] px-4 py-3 text-sm text-[var(--text)] outline-none transition-colors focus:border-[var(--accent)] focus:bg-[var(--panel-solid)]"></textarea>
        </label>
      </div>
      <div class="flex items-center justify-between gap-4 pt-2">
        <p id="contact-status" aria-live="polite" class="text-xs font-mono text-[var(--muted)]"></p>
        <button type="submit" class="btn-cinematic-primary">
          <span>Send transmission</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </section>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-status');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      status.textContent = 'Sending...';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();
        if (!response.ok) {
          throw new Error(result.error || 'Unable to send message right now.');
        }

        status.textContent = result.message || 'Message sent successfully.';
        form.reset();
      } catch (error) {
        status.textContent = 'Unable to send your message right now. Please try again or email directly.';
      }
    });
  </script>
</BaseLayout>
