---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { postId: post.id }
  }));
}

const posts = await getCollection('blog');
const post = posts.find((entry) => entry.id === Astro.props.postId) ?? posts[0];
const { Content } = await render(post);
const slug = post.id.replace(/\.mdx?$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: `${SITE_URL}/og/blog-${slug}.svg`,
  datePublished: post.data.pubDate,
  dateModified: post.data.updatedDate || post.data.pubDate,
  author: {
    '@type': 'Person',
    name: post.data.author || 'Yug Shah'
  },
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: `${SITE_URL}/blog/${slug}`
};
---

<BaseLayout title={`${post.data.title} | Blog | Yug Shah`} description={post.data.description} image={`/og/blog-${slug}.svg`} jsonLd={jsonLd} canonicalPath={`/blog/${slug}`} type="article">
  <article class="mx-auto max-w-4xl space-y-8 py-8">
    <div>
      <a href="/blog" class="inline-flex items-center gap-2 text-xs font-mono text-[var(--accent-strong)] hover:underline">
        <span aria-hidden="true">←</span> Return to field notes
      </a>
    </div>

    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <span class="rounded-full border border-[var(--border-accent)] bg-[var(--accent-soft)] px-3 py-1 text-xs font-mono font-medium text-[var(--accent-strong)]">RESEARCH NOTE</span>
        <span class="text-xs font-mono text-[var(--muted)]">
          {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </span>
      </div>
      <h1 class="hero-main-title text-4xl font-black tracking-tight sm:text-5xl leading-tight">{post.data.title}</h1>
      <p class="text-lg text-[var(--text-secondary)] leading-relaxed">{post.data.description}</p>
      
      <div class="flex flex-wrap gap-2 pt-1">
        {post.data.tags.map((tag) => (
          <a href={`/blog/tags/${tag}`} class="rounded-full border border-[var(--border-w)] border-[var(--border)] bg-[var(--bg-soft)] px-3 py-1 text-xs font-mono uppercase tracking-[0.08em] text-[var(--muted)] hover:border-[var(--accent)] hover:text-[var(--text)] transition-colors">{tag}</a>
        ))}
      </div>
    </div>

    <div class="rounded-[32px] border border-[var(--border-thick)] border-[var(--border)] bg-[var(--panel)] p-6 sm:p-10 backdrop-blur-md shadow-2xl text-base leading-relaxed text-[var(--text)]">
      {post.data.contentHtml
        ? <div class="medium-article" set:html={post.data.contentHtml} />
        : <div class="prose prose-invert max-w-none"><Content /></div>}
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[var(--border)]">
      <a href="/blog" class="btn-cinematic-secondary">← Back to all notes</a>
      {post.data.mediumUrl && (
        <a href={post.data.mediumUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[var(--accent-strong)] hover:underline">
          <span>Read original on Medium</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </article>
</BaseLayout>
