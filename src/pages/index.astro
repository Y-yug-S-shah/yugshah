---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import resume from '../data/resume.json';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../config/site';

const featuredProjects = projects.filter((project) => project.featured);
const featuredExperience = resume.work;
const fieldNotes = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 2);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.name,
  url: SITE_URL,
  description: profile.bio,
  publisher: {
    '@type': 'Person',
    name: profile.name,
    url: SITE_URL,
    email: profile.email
  }
};
const skillAreas = [
  {
    name: 'AI security',
    label: 'AI',
    tone: 'violet',
    detail: 'Protecting intelligent systems from prompt injection, unsafe tools, and untrusted data.',
    topics: ['Agent safety', 'Runtime trust']
  },
  {
    name: 'Endpoint security',
    label: 'EDR',
    tone: 'blue',
    detail: 'Building visibility into endpoint activity and investigating suspicious behavior.',
    topics: ['Threat detection', 'Response']
  },
  {
    name: 'Cloud security',
    label: 'CLD',
    tone: 'mint',
    detail: 'Reducing cloud risk through identity controls, secure configuration, and monitoring.',
    topics: ['Cloud posture', 'Identity']
  },
  {
    name: 'Network security',
    label: 'NET',
    tone: 'amber',
    detail: 'Understanding traffic, strengthening boundaries, and spotting threats in motion.',
    topics: ['Traffic analysis', 'Defense']
  }
];
---

<BaseLayout title="Yug Shah | Security Engineer" description={profile.bio} image="/og/home.svg" jsonLd={jsonLd}>
  <section class="home-hero grid gap-8 py-8 md:grid-cols-[1.15fr_0.85fr] md:items-center lg:py-14">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2.5 rounded-full border border-[var(--border-accent)] bg-[var(--accent-soft)] px-3.5 py-1.5 text-xs font-mono font-medium text-[var(--accent-strong)] backdrop-blur-md">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="tracking-wider">SECURITY RESEARCH // INTELLIGENT SYSTEMS</span>
      </div>

      <div class="space-y-4">
        <h1 class="hero-main-title max-w-xl text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">
          {profile.name}
        </h1>
        <p class="max-w-xl text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed">
          {profile.tagline}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a href="/resume" class="btn-cinematic-primary">
          <span>View resume</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/projects" class="btn-cinematic-secondary">Browse projects</a>
        <a href="/game" class="btn-cinematic-agent" title="Play Milo’s security simulation">
          <span aria-hidden="true">🎮</span>
          <span>Milo’s simulation</span>
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-5 pt-1 text-xs font-mono text-[var(--muted)]">
        <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--accent-strong)]">LinkedIn ↗</a>
        <a href={profile.socialLinks.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--accent-strong)]">GitHub ↗</a>
        <a href={profile.socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--accent-strong)]">YouTube ↗</a>
        <a href={`mailto:${profile.email}`} class="transition-colors hover:text-[var(--accent-strong)]">Email ↗</a>
      </div>
    </div>

    <aside class="hero-console rounded-[32px] border border-[var(--border)] p-6 sm:p-7">
      <div class="hero-console-bar">
        <div class="hero-console-dots" aria-hidden="true">
          <span class="hero-console-dot hero-console-dot-red"></span>
          <span class="hero-console-dot hero-console-dot-amber"></span>
          <span class="hero-console-dot hero-console-dot-green"></span>
        </div>
        <span class="hero-note-reference">FIELD NOTE / 01</span>
      </div>

      <h2>When an AI reads a webpage, whose instructions does it trust?</h2>
      <p>My field notes unpack indirect prompt injection and practical ways to limit what an agent can see and do.</p>

      <div class="hero-telemetry-box" aria-hidden="true">
        <div><span class="hero-telemetry-tag">[RUNTIME AUDIT]</span> EVALUATING UNTRUSTED WEBPAGE</div>
        <div><span class="hero-telemetry-alert">! DETECTED</span> INDIRECT PROMPT INJECTION VECTOR</div>
        <div><span class="hero-telemetry-ok">✓ CONTAIN</span> RUNTIME SANDBOX BOUNDARY APPLIED</div>
      </div>

      <a class="hero-note-link" href="/blog/ai-security-prompt-injection">Read the investigation <span aria-hidden="true">↗</span></a>
      <div class="hero-note-rule" aria-hidden="true"></div>
      <div class="hero-note-meta">
        <span>Prompt injection</span>
        <span>Research and controls</span>
        <span>Agent Trust</span>
      </div>
    </aside>
  </section>

  <section class="py-10">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <p class="section-kicker">Architecture & Mission</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">About</h2>
      </div>
    </div>
    <div class="about-bento-grid">
      <div class="about-card-main">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-[var(--accent-strong)]">// CORE PHILOSOPHY</span>
          <h3 class="mt-3 text-xl font-bold tracking-tight text-[var(--text)] sm:text-2xl">
            Bridging technical validation with high-stakes defense.
          </h3>
          <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">
            {profile.bio}
          </p>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-3 pt-4 border-t border-[var(--border)] text-xs font-mono text-[var(--muted)]">
          <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-[var(--accent-teal)]"></span> Zero Trust Runtimes</span>
          <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span> Technical PoC Delivery</span>
          <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-[var(--accent-coral)]"></span> SIEM Analytics</span>
        </div>
      </div>
      <div class="about-card-side">
        <div class="about-stat-tile">
          <span class="about-stat-badge">ENTERPRISE VALIDATION</span>
          <h4 class="about-stat-title">Palo Alto Networks</h4>
          <p class="about-stat-desc">Technical Solutions & customer PoC delivery across enterprise security infrastructure.</p>
        </div>
        <div class="about-stat-tile">
          <span class="about-stat-badge">RESEARCH FOCUS</span>
          <h4 class="about-stat-title">AI & Agentic Security</h4>
          <p class="about-stat-desc">Detections for indirect prompt injection, tool authorization, and runtime model execution.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-10">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <p class="section-kicker">Core Domains</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">Areas I work in</h2>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {skillAreas.map((skill) => (
        <article class={`skill-card skill-${skill.tone}`}>
          <div class="skill-card-heading">
            <span aria-hidden="true">{skill.label}</span>
            <h3>{skill.name}</h3>
          </div>
          <p>{skill.detail}</p>
          <ul aria-label={`${skill.name} topics`}>
            {skill.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="experience-section py-10" aria-labelledby="experience-title">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="section-kicker">Track Record</p>
        <h2 id="experience-title" class="mt-2 text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">Security engineering, in practice.</h2>
      </div>
      <a href="/resume" class="text-xs font-mono font-medium text-[var(--accent-strong)] hover:underline">Full resume →</a>
    </div>
    <div class="experience-list">
      {featuredExperience.map((job) => (
        <article class={`experience-card${job.company === 'Palo Alto Networks' ? ' is-palo-alto' : ''}`}>
          <div class="experience-mark" aria-hidden="true">{job.company === 'Palo Alto Networks' ? 'PAN' : job.company.slice(0, 3).toUpperCase()}</div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3>{job.position}</h3>
              <span class="experience-date">{job.startDate} — {job.endDate}</span>
            </div>
            <p class="experience-company">{job.company}</p>
            <p class="experience-summary">{job.summary}</p>
          </div>
          {job.company === 'Palo Alto Networks' && <span class="experience-badge">CUSTOMER SECURITY</span>}
        </article>
      ))}
    </div>
  </section>

  <section class="py-10">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <p class="section-kicker">Engineered Detections</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">Featured projects</h2>
      </div>
      <a href="/projects" class="text-xs font-mono font-medium text-[var(--accent-strong)] hover:underline">See all →</a>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {featuredProjects.map((project) => (
        <article class="group relative overflow-hidden rounded-[28px] border border-[var(--border)] bg-[var(--panel)] transition-all duration-300 hover:-translate-y-1 hover:border-[var(--border-accent)] hover:shadow-2xl hover:shadow-[var(--shadow)]">
          <div class="relative h-48 w-full overflow-hidden bg-[var(--bg-soft)]">
            <img src={project.image} alt={project.imageAlt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--panel-solid)] via-transparent to-transparent opacity-70" />
            <span class="absolute top-4 right-4 rounded-full border border-[var(--border)] bg-[var(--bg)]/80 px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider text-[var(--muted)] backdrop-blur-md">{project.year}</span>
          </div>
          <div class="space-y-4 p-6">
            <h3 class="text-xl font-bold text-[var(--text)] group-hover:text-[var(--accent-strong)] transition-colors">{project.title}</h3>
            <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{project.summary}</p>
            <div class="flex flex-wrap gap-2 pt-1">
              {project.tech.map((tech) => (
                <span class="rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.08em] text-[var(--muted)]">{tech}</span>
              ))}
            </div>
            <div class="pt-2">
              <a href={`/projects/${project.slug}`} class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[var(--accent-strong)] group-hover:gap-2.5 transition-all">
                <span>Explore project</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-field-notes py-10" aria-labelledby="field-notes-title">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <p class="section-kicker">Research Notebook</p>
        <h2 id="field-notes-title" class="mt-2 text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">Field notes on AI security</h2>
      </div>
      <a href="/blog" class="text-xs font-mono font-medium text-[var(--accent-strong)] hover:underline">All articles <span aria-hidden="true">↗</span></a>
    </div>
    <div class="field-note-grid">
      {fieldNotes.map((post, index) => (
        <article class={`field-note-card field-note-card-${index + 1}`}>
          <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`} class="field-note-cover">
            <img src={post.data.cover || '/placeholder-project.svg'} alt="" loading="lazy" />
            <span>{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
          </a>
          <div class="field-note-copy">
            <h3><a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <a class="field-note-read" href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}>Read the field note <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="game-preview py-8">
    <div class="game-preview-copy">
      <p class="section-kicker">Interactive threat exercise</p>
      <h2>Can you spot the instruction hidden in the data?</h2>
      <p>Guide Milo through a compromised runtime. Collect controls, contain an indirect prompt injection, and keep a roaming threat away from the agent.</p>
      <a href="/game" class="game-preview-link">Enter Milo’s simulation <span aria-hidden="true">↗</span></a>
    </div>
    <div class="game-preview-art" aria-hidden="true">
      <span class="preview-orbit preview-orbit-one"></span>
      <span class="preview-orbit preview-orbit-two"></span>
      <span class="preview-security-node node-ai">UNTRUSTED INPUT</span>
      <span class="preview-security-node node-edge">POLICY</span>
      <span class="preview-security-node node-cloud">TOOL ACCESS</span>
      <span class="preview-agent-core">M</span>
    </div>
  </section>
</BaseLayout>
