---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import resume from '../data/resume.json';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../config/site';

const featuredProjects = projects.filter((project) => project.featured);
const featuredExperience = resume.work;
const fieldNotes = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 2);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.name,
  url: SITE_URL,
  description: profile.bio,
  publisher: {
    '@type': 'Person',
    name: profile.name,
    url: SITE_URL,
    email: profile.email
  }
};
const skillAreas = [
  {
    name: 'AI security',
    label: 'AI',
    tone: 'violet',
    detail: 'Protecting intelligent systems from prompt injection, unsafe tools, and untrusted data.',
    topics: ['Agent safety', 'Runtime trust']
  },
  {
    name: 'Endpoint security',
    label: 'EDR',
    tone: 'blue',
    detail: 'Building visibility into endpoint activity and investigating suspicious behavior.',
    topics: ['Threat detection', 'Response']
  },
  {
    name: 'Cloud security',
    label: 'CLD',
    tone: 'mint',
    detail: 'Reducing cloud risk through identity controls, secure configuration, and monitoring.',
    topics: ['Cloud posture', 'Identity']
  },
  {
    name: 'Network security',
    label: 'NET',
    tone: 'amber',
    detail: 'Understanding traffic, strengthening boundaries, and spotting threats in motion.',
    topics: ['Traffic analysis', 'Defense']
  }
];
---

<BaseLayout title="Yug Shah | Security Engineer" description={profile.bio} image="/og/home.svg" jsonLd={jsonLd}>
  <section class="home-hero grid gap-8 py-8 md:grid-cols-[1.15fr_0.85fr] md:items-center lg:py-14">
    <div class="space-y-6">
      <p class="hero-discipline">
        Security engineering / intelligent systems
      </p>
      <div class="space-y-4">
        <h1 class="max-w-xl text-4xl font-black tracking-tight text-[var(--text)] sm:text-5xl lg:text-6xl">
          {profile.name}
        </h1>
        <p class="max-w-2xl text-lg text-[var(--muted)]">{profile.tagline}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/resume" class="inline-flex rounded-full bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-[var(--accent-soft)] transition-transform hover:-translate-y-0.5">View resume</a>
        <a href="/projects" class="inline-flex rounded-full border border-[var(--border)] bg-[var(--panel)] px-5 py-3 text-sm font-semibold text-[var(--text)] transition-transform hover:-translate-y-0.5">Browse projects</a>
        <a href="/game" class="inline-flex rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-5 py-3 text-sm font-semibold text-[var(--text)] transition-transform hover:-translate-y-0.5">Play Milo’s security simulation</a>
      </div>
      <div class="flex flex-wrap gap-6 pt-2 text-sm text-[var(--muted)]">
        <a href={profile.socialLinks.linkedin} class="hover:text-[var(--text)]">LinkedIn</a>
        <a href={profile.socialLinks.github} class="hover:text-[var(--text)]">GitHub</a>
        <a href={profile.socialLinks.youtube} class="hover:text-[var(--text)]">YouTube</a>
        <a href={`mailto:${profile.email}`} class="hover:text-[var(--text)]">Email</a>
      </div>
    </div>

    <aside class="hero-console rounded-[32px] border border-[var(--border)] p-6">
      <p class="hero-note-reference">FIELD NOTE / 01</p>
      <h2>When an AI reads a webpage, whose instructions does it trust?</h2>
      <p>My field notes unpack indirect prompt injection and practical ways to limit what an agent can see and do.</p>
      <a class="hero-note-link" href="/blog/ai-security-prompt-injection">Read the investigation <span aria-hidden="true">↗</span></a>
      <div class="hero-note-rule" aria-hidden="true"></div>
      <div class="hero-note-meta">
        <span>Prompt injection</span>
        <span>Research and controls</span>
      </div>
    </aside>
  </section>

  <section class="py-8">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--text)]">About</h2>
    </div>
    <div class="rounded-[28px] border border-[var(--border)] bg-[var(--panel)] p-6 text-base leading-8 text-[var(--muted)]">
      {profile.bio}
    </div>
  </section>

  <section class="py-8">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--text)]">Areas I work in</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {skillAreas.map((skill) => (
        <article class={`skill-card skill-${skill.tone}`}>
          <div class="skill-card-heading">
            <span aria-hidden="true">{skill.label}</span>
            <h3>{skill.name}</h3>
          </div>
          <p>{skill.detail}</p>
          <ul aria-label={`${skill.name} topics`}>
            {skill.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="experience-section py-8" aria-labelledby="experience-title">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="section-kicker">Selected work</p>
        <h2 id="experience-title" class="mt-2 text-2xl font-bold tracking-tight text-[var(--text)]">AI security, in practice.</h2>
      </div>
      <a href="/resume" class="text-sm font-medium text-[var(--accent-strong)]">Full resume →</a>
    </div>
    <div class="experience-list">
      {featuredExperience.map((job) => (
        <article class={`experience-card${job.company === 'Palo Alto Networks' ? ' is-palo-alto' : ''}`}>
          <div class="experience-mark" aria-hidden="true">{job.company === 'Palo Alto Networks' ? 'PAN' : job.company.slice(0, 3).toUpperCase()}</div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3>{job.position}</h3>
              <span class="experience-date">{job.startDate} — {job.endDate}</span>
            </div>
            <p class="experience-company">{job.company}</p>
            <p class="experience-summary">{job.summary}</p>
          </div>
          {job.company === 'Palo Alto Networks' && <span class="experience-badge">CUSTOMER SECURITY</span>}
        </article>
      ))}
    </div>
  </section>

  <section class="py-8">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--text)]">Featured projects</h2>
      <a href="/projects" class="text-sm font-medium text-[var(--accent-strong)]">See all</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {featuredProjects.map((project) => (
        <article class="overflow-hidden rounded-[28px] border border-[var(--border)] bg-[var(--panel)]">
          <img src={project.image} alt={project.imageAlt} class="h-48 w-full object-cover" />
          <div class="space-y-4 p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold text-[var(--text)]">{project.title}</h3>
              <span class="text-xs uppercase tracking-[0.2em] text-[var(--muted)]">{project.year}</span>
            </div>
            <p class="text-sm leading-7 text-[var(--muted)]">{project.summary}</p>
            <div class="flex flex-wrap gap-2">
              {project.tech.map((tech) => (
                <span class="rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--muted)]">{tech}</span>
              ))}
            </div>
            <a href={`/projects/${project.slug}`} class="inline-flex text-sm font-semibold text-[var(--accent-strong)]">Explore project →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-field-notes py-8" aria-labelledby="field-notes-title">
    <div class="home-section-heading">
      <div>
        <p class="section-kicker">From the research notebook</p>
        <h2 id="field-notes-title">Field notes on AI security</h2>
      </div>
      <a href="/blog">All articles <span aria-hidden="true">↗</span></a>
    </div>
    <div class="field-note-grid">
      {fieldNotes.map((post, index) => (
        <article class={`field-note-card field-note-card-${index + 1}`}>
          <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`} class="field-note-cover">
            <img src={post.data.cover || '/placeholder-project.svg'} alt="" loading="lazy" />
            <span>{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
          </a>
          <div class="field-note-copy">
            <h3><a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <a class="field-note-read" href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}>Read the field note <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="game-preview py-8">
    <div class="game-preview-copy">
      <p class="section-kicker">Interactive threat exercise</p>
      <h2>Can you spot the instruction hidden in the data?</h2>
      <p>Guide Milo through a compromised runtime. Collect controls, contain an indirect prompt injection, and keep a roaming threat away from the agent.</p>
      <a href="/game" class="game-preview-link">Enter Milo’s simulation <span aria-hidden="true">↗</span></a>
    </div>
    <div class="game-preview-art" aria-hidden="true">
      <span class="preview-orbit preview-orbit-one"></span>
      <span class="preview-orbit preview-orbit-two"></span>
      <span class="preview-security-node node-ai">UNTRUSTED INPUT</span>
      <span class="preview-security-node node-edge">POLICY</span>
      <span class="preview-security-node node-cloud">TOOL ACCESS</span>
      <span class="preview-agent-core">M</span>
    </div>
  </section>
</BaseLayout>
