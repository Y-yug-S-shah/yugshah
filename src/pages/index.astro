---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../config/site';

const latestBlogs = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const featuredPost = latestBlogs[0];
const recentPosts = latestBlogs.slice(1);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.name,
  url: SITE_URL,
  description: profile.tagline,
  publisher: {
    '@type': 'Person',
    name: profile.name,
    url: SITE_URL,
    email: profile.email
  }
};
---

<BaseLayout title="Yug Shah | Security Blog & Milo's Mission" description={profile.tagline} image="/og/home.svg" jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="home-hero grid gap-10 py-10 md:grid-cols-[1.15fr_0.85fr] md:items-center lg:py-16">
    <div class="space-y-6">
      <div class="space-y-4">
        <h1 class="hero-main-title hero-animate-title max-w-xl text-4xl font-black sm:text-5xl lg:text-6xl leading-[1.25]">
          {profile.name}
        </h1>
        <p class="hero-animate-sub max-w-xl text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed">
          {profile.tagline}
        </p>
      </div>

      <div class="hero-animate-cta flex flex-wrap items-center gap-3 pt-1">
        <a href="/blog" class="btn-cinematic-primary group inline-flex items-center gap-2">
          <span>Read the Blog</span>
          <span class="inline-flex items-center rounded-md bg-[var(--bg)]/30 px-2 py-0.5 text-[10px] font-mono font-bold tracking-wider uppercase text-[var(--accent-strong)]">Articles &rarr;</span>
        </a>
        <a href="/game" class="btn-cinematic-secondary group inline-flex items-center gap-2" title="Play Milo's Mission">
          <span aria-hidden="true">🎮</span>
          <span>Play Milo's Mission</span>
          <span class="inline-flex items-center rounded-md bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-mono font-bold text-amber-400">Interactive</span>
        </a>
      </div>

      <div class="hero-animate-social flex flex-wrap items-center gap-5 pt-1 text-xs font-mono text-[var(--muted)]">
        <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--accent-strong)]">LinkedIn &nearr;</a>
        <a href={profile.socialLinks.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--accent-strong)]">GitHub &nearr;</a>
        <a href={profile.socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--accent-strong)]">YouTube &nearr;</a>
        <a href={`mailto:${profile.email}`} class="transition-colors hover:text-[var(--accent-strong)]">Email &nearr;</a>
      </div>
    </div>

    <!-- Featured Research Highlight -->
    {featuredPost && (
      <aside class="hero-console hero-animate-console rounded-[24px] border border-[var(--border)] p-7 sm:p-8">
        <div class="hero-console-bar">
          <div class="hero-console-dots" aria-hidden="true">
            <span class="hero-console-dot hero-console-dot-red"></span>
            <span class="hero-console-dot hero-console-dot-amber"></span>
            <span class="hero-console-dot hero-console-dot-green"></span>
          </div>
          <span class="hero-note-reference">LATEST POST &bull; {new Date(featuredPost.data.pubDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
        </div>

        <h2 class="text-xl sm:text-2xl font-bold text-[var(--text)] mt-3">{featuredPost.data.title}</h2>
        <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">{featuredPost.data.description}</p>

        <div id="hero-telemetry-feed" class="hero-telemetry-box mt-4" aria-live="polite">
          <div class="telemetry-line-1 transition-opacity duration-500"><span class="hero-telemetry-tag">[LATEST]</span> NEW ARTICLE PUBLISHED</div>
          <div class="telemetry-line-2 transition-opacity duration-500"><span class="hero-telemetry-alert">! TOPIC</span> {featuredPost.data.tags?.[0]?.toUpperCase() || 'SECURITY'}</div>
          <div class="telemetry-line-3 transition-opacity duration-500"><span class="hero-telemetry-ok">&check; READ</span> DEEP DIVE AVAILABLE</div>
        </div>

        <div class="mt-5 flex items-center justify-between">
          <a class="hero-note-link font-semibold" href={`/blog/${featuredPost.id.replace(/\.mdx?$/, '')}`}>Read article &nearr;</a>
          <a class="text-xs font-mono text-[var(--muted)] hover:text-[var(--accent-strong)]" href="/game">Play Milo's Mission &rarr;</a>
        </div>
        <div class="hero-note-rule" aria-hidden="true"></div>
        <div class="hero-note-meta">
          {featuredPost.data.tags?.slice(0, 3).map((tag: string) => (
            <span>{tag}</span>
          ))}
        </div>
      </aside>
    )}
  </section>

  <!-- Blog / Security Research Section -->
  <section class="home-blogs py-12 sm:py-16" aria-labelledby="blog-section-title">
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="section-kicker">Security Research &amp; Articles</p>
        <h2 id="blog-section-title" class="mt-2 text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">Latest from the blog</h2>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">Technical investigations into adversarial AI, prompt injection defense, agent sandboxing, and runtime identity.</p>
      </div>
      <a href="/blog" class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border-accent)] bg-[var(--accent-soft)] px-4 py-2 text-xs font-mono font-semibold text-[var(--accent-strong)] transition-all hover:bg-[var(--accent)] hover:text-white shrink-0">Explore all articles &rarr;</a>
    </div>
    <div class="blog-grid">
      {latestBlogs.map((post, index) => (
        <article class={`blog-card blog-card-${index + 1}`}>
          <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`} class="blog-cover">
            <img src={post.data.cover || '/media/ai-security-prompt-injection.svg'} alt={post.data.title} loading="lazy" />
            <span>{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
          </a>
          <div class="blog-copy">
            <div class="mb-2 flex flex-wrap gap-1.5">
              {post.data.tags?.slice(0, 3).map((tag: string) => (
                <span class="rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-2 py-0.5 text-[10px] font-mono uppercase text-[var(--muted)]">{tag}</span>
              ))}
            </div>
            <h3><a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <a class="blog-read" href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}>Read article <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Interactive Milo Security Simulation Promo -->
  <section class="game-preview mt-12 sm:mt-16 py-8">
    <div class="game-preview-copy">
      <p class="section-kicker">Interactive Threat Exercise</p>
      <h2>Can you spot the instruction hidden in the data?</h2>
      <p>Guide Milo through a compromised runtime. Collect controls, contain an indirect prompt injection, and keep a roaming threat away from the agent.</p>
      <div class="pt-2 flex flex-wrap items-center gap-3">
        <a href="/game" class="game-preview-link">Enter Milo's simulation <span aria-hidden="true">&nearr;</span></a>
        <a href="/blog/ai-security-prompt-injection" class="text-xs font-mono text-[var(--accent-strong)] hover:underline">Read the prompt injection research &rarr;</a>
      </div>
    </div>
    <div class="game-preview-art" aria-hidden="true">
      <span class="preview-orbit preview-orbit-one"></span>
      <span class="preview-orbit preview-orbit-two"></span>
      <span class="preview-security-node node-ai">UNTRUSTED INPUT</span>
      <span class="preview-security-node node-edge">POLICY</span>
      <span class="preview-security-node node-cloud">TOOL ACCESS</span>
      <span class="preview-agent-core">M</span>
    </div>
  </section>

  <script is:inline>
    (() => {
      function runLandingTelemetryAnimation() {
        const feed = document.getElementById('hero-telemetry-feed');
        if (!feed) return;
        const line1 = feed.querySelector('.telemetry-line-1');
        const line2 = feed.querySelector('.telemetry-line-2');
        const line3 = feed.querySelector('.telemetry-line-3');
        if (!line1 || !line2 || !line3) return;

        line1.style.opacity = '0';
        line2.style.opacity = '0';
        line3.style.opacity = '0';

        setTimeout(() => {
          line1.style.opacity = '1';
        }, 350);

        setTimeout(() => {
          line2.style.opacity = '1';
        }, 950);

        setTimeout(() => {
          line3.style.opacity = '1';
        }, 1550);
      }

      document.addEventListener('astro:page-load', runLandingTelemetryAnimation);
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        runLandingTelemetryAnimation();
      } else {
        document.addEventListener('DOMContentLoaded', runLandingTelemetryAnimation);
      }
    })();
  </script>
</BaseLayout>
