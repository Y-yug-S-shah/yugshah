---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import resume from '../data/resume.json';
import { SITE_URL } from '../config/site';

const featuredProjects = projects.filter((project) => project.featured);
const featuredExperience = resume.work;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.name,
  url: SITE_URL,
  description: profile.bio,
  publisher: {
    '@type': 'Person',
    name: profile.name,
    url: SITE_URL,
    email: profile.email
  }
};
const skillTree = [
  'Threat hunting',
  'Identity security',
  'Network validation',
  'SOC workflows',
  'Automation',
  'Customer enablement'
];
---

<BaseLayout title="Yug Shah | Security Engineer" description={profile.bio} image="/og/home.svg" jsonLd={jsonLd}>
  <section class="grid gap-8 py-8 md:grid-cols-[1.3fr_0.7fr] md:items-center lg:py-14">
    <div class="space-y-6">
      <p class="inline-flex rounded-full border border-[var(--border)] bg-[var(--panel)] px-3 py-1 text-xs font-semibold uppercase tracking-[0.28em] text-[var(--muted)]">
        AI SECURITY · HUMAN-CENTERED SYSTEMS
      </p>
      <div class="space-y-4">
        <h1 class="max-w-xl text-4xl font-black tracking-tight text-[var(--text)] sm:text-5xl lg:text-6xl">
          {profile.name}
        </h1>
        <p class="max-w-2xl text-lg text-[var(--muted)]">{profile.tagline}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/resume" class="inline-flex rounded-full bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-[var(--accent-soft)] transition-transform hover:-translate-y-0.5">View resume</a>
        <a href="/projects" class="inline-flex rounded-full border border-[var(--border)] bg-[var(--panel)] px-5 py-3 text-sm font-semibold text-[var(--text)] transition-transform hover:-translate-y-0.5">Browse projects</a>
        <a href="/game" class="inline-flex rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-5 py-3 text-sm font-semibold text-[var(--text)] transition-transform hover:-translate-y-0.5">Meet an AI friend</a>
      </div>
      <div class="flex flex-wrap gap-6 pt-2 text-sm text-[var(--muted)]">
        <a href={profile.socialLinks.linkedin} class="hover:text-[var(--text)]">LinkedIn</a>
        <a href={profile.socialLinks.github} class="hover:text-[var(--text)]">GitHub</a>
        <a href={profile.socialLinks.youtube} class="hover:text-[var(--text)]">YouTube</a>
        <a href={`mailto:${profile.email}`} class="hover:text-[var(--text)]">Email</a>
      </div>
    </div>

    <aside class="hero-console rounded-[32px] border border-[var(--border)] p-6">
      <div class="mb-4 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--muted)]">Security operations</span>
        <span class="rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">Thoughtful</span>
      </div>
      <div class="relative z-[1]">
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--muted)]">Human + machine</p>
        <p class="mt-2 text-2xl font-black tracking-tight text-[var(--text)]">Useful AI starts with thoughtful security.</p>
        <p class="mt-3 text-sm leading-7 text-[var(--muted)]">Exploring how people, intelligent systems, and practical security can work better together.</p>
        <div class="mt-6 grid grid-cols-3 gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]">
          <span class="rounded-xl border border-[var(--border)] bg-[var(--bg-soft)] px-2 py-3 text-center">Investigate</span>
          <span class="rounded-xl border border-[var(--border)] bg-[var(--bg-soft)] px-2 py-3 text-center">Validate</span>
          <span class="rounded-xl border border-[var(--border)] bg-[var(--bg-soft)] px-2 py-3 text-center">Communicate</span>
        </div>
      </div>
    </aside>
  </section>

  <section class="py-8">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--text)]">About</h2>
    </div>
    <div class="rounded-[28px] border border-[var(--border)] bg-[var(--panel)] p-6 text-base leading-8 text-[var(--muted)]">
      {profile.bio}
    </div>
  </section>

  <section class="py-8">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--text)]">Skill tree</h2>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {skillTree.map((skill, index) => (
        <div class="rounded-[24px] border border-[var(--border)] bg-[var(--panel)] p-4">
          <div class="mb-3 flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">Lv. {index + 1}</span>
            <span class="text-lg">{index % 2 === 0 ? '⚡' : '🛡️'}</span>
          </div>
          <h3 class="text-lg font-bold text-[var(--text)]">{skill}</h3>
        </div>
      ))}
    </div>

    <div class="mt-6 rounded-[28px] border border-[var(--border)] bg-[var(--panel)] p-6">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-[var(--muted)]">Project map</p>
      <div class="flex flex-wrap gap-3">
        {projects.map((project) => (
          <a href={`/projects/${project.slug}`} class="rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text)]">
            {project.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="experience-section py-8" aria-labelledby="experience-title">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="section-kicker">Professional experience</p>
        <h2 id="experience-title" class="mt-2 text-2xl font-bold tracking-tight text-[var(--text)]">Security work, in practice.</h2>
      </div>
      <a href="/resume" class="text-sm font-medium text-[var(--accent-strong)]">Full resume →</a>
    </div>
    <div class="experience-list">
      {featuredExperience.map((job) => (
        <article class={`experience-card${job.company === 'Palo Alto Networks' ? ' is-palo-alto' : ''}`}>
          <div class="experience-mark" aria-hidden="true">{job.company === 'Palo Alto Networks' ? 'PAN' : job.company.slice(0, 3).toUpperCase()}</div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3>{job.position}</h3>
              <span class="experience-date">{job.startDate} — {job.endDate}</span>
            </div>
            <p class="experience-company">{job.company}</p>
            <p class="experience-summary">{job.summary}</p>
          </div>
          {job.company === 'Palo Alto Networks' && <span class="experience-badge">CUSTOMER SECURITY</span>}
        </article>
      ))}
    </div>
  </section>

  <section class="py-8">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--text)]">Featured projects</h2>
      <a href="/projects" class="text-sm font-medium text-[var(--accent-strong)]">See all</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {featuredProjects.map((project) => (
        <article class="overflow-hidden rounded-[28px] border border-[var(--border)] bg-[var(--panel)]">
          <img src={project.image} alt={project.imageAlt} class="h-48 w-full object-cover" />
          <div class="space-y-4 p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold text-[var(--text)]">{project.title}</h3>
              <span class="text-xs uppercase tracking-[0.2em] text-[var(--muted)]">{project.year}</span>
            </div>
            <p class="text-sm leading-7 text-[var(--muted)]">{project.summary}</p>
            <div class="flex flex-wrap gap-2">
              {project.tech.map((tech) => (
                <span class="rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--muted)]">{tech}</span>
              ))}
            </div>
            <a href={`/projects/${project.slug}`} class="inline-flex text-sm font-semibold text-[var(--accent-strong)]">Explore project →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="py-6">
    <SignalDefense client:visible />
  </section>
</BaseLayout>
