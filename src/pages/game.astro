---
import AgentMission from '../components/AgentMission';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Milo: Trust Protocol | Yug Shah',
  description: 'Guide Milo through an AI security environment, collect trusted policies, avoid an injected payload, and secure the agent runtime.',
  url: `${SITE_URL}/game`
};
---

<BaseLayout
  title="Milo: Trust Protocol | Yug Shah"
  description="Play Milo: Trust Protocol, a movement-based AI-security game. Gather runtime trust policies, avoid an injected payload, and secure the tool gateway."
  image="/og/home.svg"
  jsonLd={jsonLd}
  canonicalPath="/game"
>
  <section class="game-page-intro">
    <h1>Protect Milo from a poisoned source.</h1>
    <p>Collect policy keys, quarantine a hidden instruction, and avoid the roaming payload. Choose a difficulty before the run. Your score can be added to the public board with a nickname, or skipped.</p>
  </section>
  <AgentMission client:load />
</BaseLayout>
