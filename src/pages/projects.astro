---
import BaseLayout from '../layouts/BaseLayout.astro';
import projects from '../data/projects.json';
import { SITE_URL } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects',
  description: 'Explore selected portfolio projects from Yug Shah.',
  hasPart: projects.map((project) => ({
    '@type': 'CreativeWork',
    name: project.title,
    description: project.summary,
    url: `${SITE_URL}/projects/${project.slug}`
  }))
};
---

<BaseLayout title="Projects | Yug Shah" description="Explore selected portfolio projects from Yug Shah." image="/og/projects.svg" jsonLd={jsonLd} canonicalPath="/projects">
  <section class="space-y-12 py-12 sm:py-16">
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border-accent)] bg-[var(--accent-soft)] px-3.5 py-1.5 text-xs font-mono font-medium text-[var(--accent-strong)] backdrop-blur-md">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="tracking-wider">SECURITY RESEARCH & SIEM DETECTIONS</span>
      </div>
      <h1 class="hero-main-title text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">Selected work</h1>
      <p class="max-w-2xl text-base text-[var(--text-secondary)] leading-relaxed">
        Production detections, threat hunting tools, and defensive infrastructure built for technical validation and practical resilience.
      </p>
    </div>

    <div class="grid gap-7 md:grid-cols-2">
      {projects.map((project) => (
        <article class="group relative overflow-hidden rounded-[22px] border border-[var(--border)] bg-[var(--panel)] transition-all duration-300 hover:-translate-y-1 hover:border-[var(--border-accent)] hover:shadow-2xl hover:shadow-[var(--shadow)]">
          <div class="relative h-52 w-full overflow-hidden bg-[var(--bg-soft)]">
            <img src={project.image} alt={project.imageAlt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--panel-solid)] via-transparent to-transparent opacity-75" />
            <span class="absolute top-4 right-4 rounded-full border border-[var(--border)] bg-[var(--bg)]/80 px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider text-[var(--muted)] backdrop-blur-md">{project.year}</span>
          </div>
          <div class="space-y-4 p-6 sm:p-7">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xl font-bold text-[var(--text)] group-hover:text-[var(--accent-strong)] transition-colors">{project.title}</h2>
              <span class="text-xs font-mono uppercase tracking-widest text-[var(--muted)]">0{projects.indexOf(project) + 1}</span>
            </div>
            <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{project.summary}</p>
            <div class="flex flex-wrap gap-2 pt-1">
              {project.tech.map((tech) => (
                <span class="rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.08em] text-[var(--muted)]">{tech}</span>
              ))}
            </div>
            <div class="flex items-center justify-between pt-3 border-t border-[var(--border)]">
              <a href={`/projects/${project.slug}`} class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[var(--accent-strong)] group-hover:gap-2.5 transition-all">
                <span>Explore detection</span>
                <span aria-hidden="true">→</span>
              </a>
              {project.links?.repo && (
                <a href={project.links.repo} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-[var(--muted)] hover:text-[var(--text)] transition-colors">
                  GitHub ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
