---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '404 Not Found',
  url: `${SITE_URL}/404`,
  description: 'The page you requested could not be found.'
};
---

<BaseLayout title="404 | Yug Shah" description="The page you requested could not be found." image="/og/home.svg" jsonLd={jsonLd} canonicalPath="/404">
  <section class="flex min-h-[55vh] flex-col items-center justify-center py-16 text-center">
    <div class="rounded-[24px] border border-[var(--border)] bg-[var(--panel)] p-8 sm:p-12 shadow-2xl backdrop-blur-md max-w-xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-red-500/30 bg-red-500/10 px-3.5 py-1 text-xs font-mono font-medium text-red-400">
        <span>ERROR 404 &middot; PAGE NOT FOUND</span>
      </div>
      <h1 class="hero-main-title mt-5 text-4xl sm:text-5xl font-black tracking-tight">Lost in the signal.</h1>
      <p class="mt-4 text-base text-[var(--text-secondary)] leading-relaxed">The route you requested could not be resolved. You have been redirected to the defensive containment perimeter.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-cinematic-primary">Return home</a>
        <a href="/blog" class="btn-cinematic-secondary">Read the blog</a>
      </div>
      <div class="mt-8 rounded-2xl border border-dashed border-[var(--border)] bg-[var(--bg-soft)] p-3.5 text-xs font-mono text-[var(--muted)]">
        <span class="font-semibold text-[var(--accent-teal)]">DIAGNOSTIC:</span> Signal lost. Safe return initialized.
      </div>
    </div>
  </section>
</BaseLayout>
