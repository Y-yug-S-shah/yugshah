---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CliTerminal from '../components/CliTerminal.tsx';
import CyberBackdrop from '../components/CyberBackdrop.astro';
import AgentSidebar from '../components/AgentSidebar.astro';
import '@fontsource-variable/manrope';
import '@fontsource-variable/fraunces';
import { SITE_URL } from '../config/site';
import profile from '../data/profile.json';

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = '/og/home.svg',
  type = 'website',
  jsonLd
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
const ogImageUrl = new URL(image, SITE_URL).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="k7J14NuZVv57T-T5lHSZDS5MyvoFJcL6mjF0_OeM3AU" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#101114" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Yug Shah" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="me" href={profile.socialLinks.linkedin} />
    <link rel="me" href={profile.socialLinks.github} />
    <link rel="me" href={profile.socialLinks.youtube} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const preferredTheme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', preferredTheme);
      })();
    </script>
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)] antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[var(--panel)] focus:px-4 focus:py-2 focus:text-[var(--text)]">Skip to content</a>
    <div class="viewport-frame" aria-hidden="true">
      <div class="viewport-frame-top"></div>
      <div class="viewport-frame-bottom"></div>
      <div class="viewport-frame-left"></div>
      <div class="viewport-frame-right"></div>
      <div class="viewport-frame-border"></div>
    </div>
    <CyberBackdrop />
    <SiteHeader />
    <CliTerminal client:only="react" />
    <div class="site-shell">
      <main id="main-content" class="site-main min-w-0 py-10">
        <slot />
      </main>
      <AgentSidebar />
    </div>
    <SiteFooter />
  </body>
</html>
