---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CliTerminal from '../components/CliTerminal.tsx';
import { SITE_URL } from '../config/site';
import profile from '../data/profile.json';

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = '/og/home.svg',
  type = 'website',
  jsonLd
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
const ogImageUrl = new URL(image, SITE_URL).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Yug Shah" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="me" href={profile.socialLinks.linkedin} />
    <link rel="me" href={profile.socialLinks.github} />
    <link rel="me" href={profile.socialLinks.youtube} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const preferredTheme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', preferredTheme);
      })();
    </script>
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)] antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[var(--panel)] focus:px-4 focus:py-2 focus:text-[var(--text)]">Skip to content</a>
    <div class="ambient-scene" aria-hidden="true">
      <span class="ambient-orb ambient-orb-one"></span>
      <span class="ambient-orb ambient-orb-two"></span>
      <span class="ambient-orb ambient-orb-three"></span>
    </div>
    <SiteHeader />
    <CliTerminal client:only="react" />
    <div class="field-companion" aria-hidden="true" title="A fox on the woodland trail">
      <svg viewBox="0 0 120 88" role="presentation">
        <defs>
          <linearGradient id="fox-edge-coat" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#efa65f" />
            <stop offset="1" stop-color="#a84f2d" />
          </linearGradient>
        </defs>
        <ellipse cx="59" cy="77" rx="38" ry="5" fill="#172419" opacity=".22" />
        <g class="edge-fox-tail">
          <path d="M86 49c21-18 34-8 25 8-6 11-18 16-30 12" fill="url(#fox-edge-coat)" />
          <path d="M105 49c9-5 11 2 6 8-3 5-8 8-13 9 5-6 8-11 7-17Z" fill="#f2e8db" />
        </g>
        <g class="edge-fox-body">
          <path d="M31 51c8-19 24-27 44-24 15 2 24 12 25 25l-8 16H42L29 60Z" fill="url(#fox-edge-coat)" />
          <path d="M59 51c10 4 20 4 31 0l9 17H43c4-9 9-14 16-17Z" fill="#efe3d2" />
          <path d="m35 40-4-22 18 13M72 31l10-21 9 24" fill="#bb633b" />
          <path d="m35 32-1-8 9 6M77 31l5-12 4 13" fill="#3a2922" />
          <path d="M40 42c9-11 24-13 37-7 9 4 15 12 14 21-14 4-32 2-51-4Z" fill="#dc8846" />
          <path d="M81 47c13-5 21-2 21 6 0 8-10 13-25 11 7-5 10-9 4-17Z" fill="#f4e9da" />
          <circle cx="81" cy="43" r="1.8" fill="#201c19" />
          <path d="m100 49 5 2-5 3" fill="#211b18" />
          <path class="edge-fox-leg edge-fox-leg-one" d="m53 62-5 11m19-10 4 10" fill="none" stroke="#80432b" stroke-linecap="round" stroke-width="6" />
          <path class="edge-fox-leg edge-fox-leg-two" d="m38 62-3 10m35-9 4 10" fill="none" stroke="#693a2a" stroke-linecap="round" stroke-width="6" />
        </g>
      </svg>
    </div>
    <main id="main-content" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const companion = document.querySelector('.field-companion');
        const canvas = null;
        const context = canvas?.getContext('2d');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let particles = [];
        let frame;
        let width = 0;
        let height = 0;
        let tick = 0;

        const fitCanvas = () => {
          if (!canvas || !context) return;
          const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = Math.round(width * ratio);
          canvas.height = Math.round(height * ratio);
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
          const count = Math.min(34, Math.max(16, Math.round(width * height / 52000)));
          particles = Array.from({ length: count }, (_, index) => ({
            x: ((index * 173 + 41) % 997) / 997 * width,
            y: ((index * 317 + 83) % 991) / 991 * height,
            radius: 1 + (index % 4) * 0.45,
            speed: 0.08 + (index % 5) * 0.025,
            phase: index * 1.71
          }));
        };

        const drawAtmosphere = () => {
          if (!context) return;
          context.clearRect(0, 0, width, height);
          particles.forEach((particle, index) => {
            particle.y -= particle.speed;
            particle.x += Math.sin(tick * 0.003 + particle.phase) * 0.12;
            if (particle.y < -8) particle.y = height + 8;
            if (particle.x < -8) particle.x = width + 8;
            if (particle.x > width + 8) particle.x = -8;
            const alpha = 0.14 + (Math.sin(tick * 0.018 + particle.phase) + 1) * 0.12;
            context.beginPath();
            context.fillStyle = index % 4 === 0
              ? `rgba(231, 185, 119, ${alpha})`
              : `rgba(106, 177, 159, ${alpha})`;
            context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
            context.fill();
            if (index % 4 === 0) return;
            let nearest = null;
            let nearestDistance = 115;
            for (let other = index + 1; other < particles.length; other += 1) {
              const dx = particle.x - particles[other].x;
              const dy = particle.y - particles[other].y;
              const distance = Math.hypot(dx, dy);
              if (distance < nearestDistance) {
                nearest = particles[other];
                nearestDistance = distance;
              }
            }
            if (nearest) {
              context.beginPath();
              context.strokeStyle = `rgba(106, 177, 159, ${0.09 * (1 - nearestDistance / 115)})`;
              context.moveTo(particle.x, particle.y);
              context.lineTo(nearest.x, nearest.y);
              context.stroke();
            }
          });
          tick += 1;
          frame = window.requestAnimationFrame(drawAtmosphere);
        };

        const startAtmosphere = () => {
          if (frame) window.cancelAnimationFrame(frame);
          fitCanvas();
          if (reduceMotion.matches) {
            drawAtmosphere();
            window.cancelAnimationFrame(frame);
            frame = undefined;
            return;
          }
          frame = window.requestAnimationFrame(drawAtmosphere);
        };

        startAtmosphere();
        window.addEventListener('resize', fitCanvas);
        reduceMotion.addEventListener('change', startAtmosphere);

        const updateScrollEffects = () => {
          const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          const progress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
          root.style.setProperty('--scroll-progress', progress.toFixed(4));
          root.style.setProperty('--bg-shift', `${Math.round(progress * 13)}%`);
          if (companion) {
            const top = Math.round(window.innerHeight * (0.18 + progress * 0.62));
            companion.style.setProperty('--companion-top', `${top}px`);
          }
        };
        updateScrollEffects();
        window.addEventListener('scroll', updateScrollEffects, { passive: true });
        window.addEventListener('resize', updateScrollEffects);

        const route = window.location.pathname.split('/').filter(Boolean);
        const visitKind = route[0] === 'blog' && route.length === 2
          ? 'blog'
          : route[0] === 'projects' && route.length === 2
            ? 'project'
            : null;
        if (visitKind) {
          const visitId = route[1];
          const visitKey = 'portfolio-garden-visits-v1';
          const readVisits = () => {
            try {
              return JSON.parse(localStorage.getItem(visitKey) || '{"blog":[],"project":[]}');
            } catch {
              return { blog: [], project: [] };
            }
          };
          const visited = readVisits();
          const startedAt = Date.now();
          let marked = visited[visitKind].includes(visitId);
          const markRead = () => {
            if (marked || Date.now() - startedAt < (visitKind === 'blog' ? 12000 : 6000)) return;
            const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
            const progress = maxScroll <= 0 ? 1 : window.scrollY / maxScroll;
            if (progress < (visitKind === 'blog' ? 0.55 : 0.35)) return;
            const next = readVisits();
            next[visitKind] = Array.from(new Set([...next[visitKind], visitId]));
            localStorage.setItem(visitKey, JSON.stringify(next));
            window.dispatchEvent(new CustomEvent('portfolio:garden-discovery', { detail: next }));
            marked = true;
          };
          window.addEventListener('scroll', markRead, { passive: true });
          window.setInterval(markRead, 1000);
        }

        if ('IntersectionObserver' in window) {
          const targets = [...document.querySelectorAll('main section, main article, main details')]
            .filter((target) => !target.closest('astro-island'));
          targets.forEach((target, index) => {
            target.setAttribute('data-reveal', '');
            target.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 70}ms`);
          });
          document.documentElement.classList.add('motion-ready');
          const observer = new IntersectionObserver((entries, currentObserver) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.setAttribute('data-visible', '');
                currentObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.08 });
          targets.forEach((target) => observer.observe(target));
        }
      })();
    </script>
  </body>
</html>
